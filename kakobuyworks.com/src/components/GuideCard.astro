---
import type { Guide } from '../lib/guides';
import type { Lang } from '../lib/i18n';

interface Props { guide: Guide; lang: Lang; readLabel: string }
const { guide, lang, readLabel } = Astro.props;
const href = `/${lang}/guides/${guide.slug}/`;
---
<article class="guide-card">
  <a class="guide-card-image" href={href} aria-label={`${readLabel}: ${guide.title}`}>
    <img src={guide.cover} alt={guide.coverAlt} loading="lazy" decoding="async" />
  </a>
  <div class="guide-card-copy">
    <div class="guide-card-meta"><time datetime={guide.date}>{guide.date}</time><span>{guide.readingTime}</span></div>
    <h3><a href={href}>{guide.title}</a></h3>
    <p>{guide.excerpt}</p>
    <a class="text-link" href={href}>{readLabel} →</a>
  </div>
</article>
