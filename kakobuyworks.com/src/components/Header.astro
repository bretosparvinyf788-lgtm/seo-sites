---
import { getCopy, languageOrder, languages, type Lang } from '../lib/i18n';
import { getGuideUi } from '../lib/guides';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = getCopy(lang);
const guideCopy = getGuideUi(lang);
const relativePath = Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '') || '/';
const routeSuffix = `${relativePath}${Astro.url.search}`;
const isHome = relativePath === '/';
const isSpreadsheet = relativePath.startsWith('/spreadsheet') || relativePath.startsWith('/search');
const isCategories = relativePath.startsWith('/categories') || relativePath.startsWith('/category');
const isFaq = relativePath.startsWith('/faq');
const isGuides = relativePath.startsWith('/guides');
const signupLabels: Record<Lang, string> = {
  en: 'Sign up', de: 'Anmelden', es: 'Registro', fr: 'S’inscrire', it: 'Registrati',
  pl: 'Rejestracja', pt: 'Criar conta', ro: 'Înregistrare', sv: 'Registrera', nl: 'Registreren',
  da: 'Opret konto', fi: 'Rekisteröidy', el: 'Εγγραφή', cs: 'Registrace', hu: 'Regisztráció',
  bg: 'Регистрация', sk: 'Registrácia', hr: 'Registracija', sl: 'Registracija', lt: 'Registracija',
  lv: 'Reģistrēties', et: 'Registreeru', ga: 'Cláraigh', mt: 'Irreġistra', zh: '新用户注册'
};
---
<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href={`/${lang}/`} aria-label="Kakobuy Spreadsheet home">
      <img src="/brand/kakobuy-logo.svg?v=20260928-1" alt="Kakobuy" width="158" height="40" />
      <span>SPREADSHEET</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class:list={{ active: isHome }} aria-current={isHome ? 'page' : undefined} href={`/${lang}/`}>{copy.nav.home}</a>
      <a class:list={{ active: isSpreadsheet }} aria-current={isSpreadsheet ? 'page' : undefined} href={`/${lang}/spreadsheet/`}>{copy.nav.spreadsheet}</a>
      <a class:list={{ active: isCategories }} aria-current={isCategories ? 'page' : undefined} href={`/${lang}/categories/`}>{copy.nav.categories}</a>
      <a class:list={{ active: isGuides }} aria-current={isGuides ? 'page' : undefined} href={`/${lang}/guides/`}>{guideCopy.nav}</a>
      <a class:list={{ active: isFaq }} aria-current={isFaq ? 'page' : undefined} href={`/${lang}/#faq`}>{copy.nav.faq}</a>
    </nav>
    <div class="nav-actions">
      <a class="button button-small signup-button" href="https://ikako.vip/r/wtqaa" target="_blank" rel="nofollow sponsored">{signupLabels[lang]}</a>
      <details class="language-menu">
        <summary>{languages[lang].label} <small>{languages[lang].short}</small> <span aria-hidden="true">⌄</span></summary>
        <div class="language-list">
          {languageOrder.map((code) => {
            const item = languages[code];
            return (
            <a href={`/${code}${routeSuffix}`} lang={code} aria-current={code === lang ? 'page' : undefined}>
              <span>{item.label}</span><small>{item.short}</small>
            </a>
            );
          })}
        </div>
      </details>
      <details class="mobile-menu">
        <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href={`/${lang}/`}>{copy.nav.home}</a>
          <a href={`/${lang}/spreadsheet/`}>{copy.nav.spreadsheet}</a>
          <a href={`/${lang}/categories/`}>{copy.nav.categories}</a>
          <a href={`/${lang}/guides/`}>{guideCopy.nav}</a>
          <a href={`/${lang}/#faq`}>{copy.nav.faq}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
