---
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; placeholder: string; button: string; value?: string; compact?: boolean; buttonAriaLabel?: string }
const { lang, placeholder, button, value = '', compact = false, buttonAriaLabel = button } = Astro.props;
---
<form class:list={['search-bar', { compact }]} action={`/${lang}/search/`} method="get" role="search">
  <label class="sr-only" for={`product-search-${compact ? 'compact' : 'hero'}`}>{placeholder}</label>
  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
  <input id={`product-search-${compact ? 'compact' : 'hero'}`} type="search" name="q" value={value} placeholder={placeholder} autocomplete="off" />
  <button type="submit" aria-label={buttonAriaLabel}>{button}</button>
</form>
