---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getProducts } from '../../lib/source';
import { getCopy, isLang } from '../../lib/i18n';

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/en/', 302);
const lang = langParam;
const copy = getCopy(lang);
const query = (Astro.url.searchParams.get('q') || '').trim().slice(0, 100);
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') || '1'));
const sort = Astro.url.searchParams.get('sort') || 'newest';
let products = [];
let sourceUnavailable = false;
if (query) {
  try { products = await getProducts({ query, page, sort }); } catch { sourceUnavailable = true; }
}
const heading = query ? `${copy.hero.search}: “${query}”` : copy.hero.search;
---
<BaseLayout lang={lang} title={`${heading} | Kakobuy Works`} description={copy.seo.searchBody} canonicalPath={`/${lang}/search/`}>
  <header class="page-hero"><div class="shell"><h1>{heading}</h1><p>{copy.seo.searchBody}</p></div></header>
  <section class="section">
    <div class="shell">
      <div class="listing-tools">
        <SearchBar lang={lang} placeholder={copy.hero.placeholder} button={copy.hero.search} value={query} compact />
        <form method="get">
          <input type="hidden" name="q" value={query} />
          <select class="sort-select" name="sort" aria-label={copy.listing.sort} onchange="this.form.submit()">
            <option value="newest" selected={sort === 'newest'}>{copy.listing.newest}</option>
            <option value="price-asc" selected={sort === 'price-asc'}>{copy.listing.priceLow}</option>
            <option value="price-desc" selected={sort === 'price-desc'}>{copy.listing.priceHigh}</option>
            <option value="name" selected={sort === 'name'}>{copy.listing.name}</option>
          </select>
        </form>
      </div>
      <ProductGrid products={products} lang={lang} detailsLabel={copy.sections.details} emptyText={sourceUnavailable ? copy.listing.sourceError : copy.listing.noResults} />
      {query && products.length > 0 && <nav class="pagination" aria-label="Pagination">
        {page > 1 && <a href={`?q=${encodeURIComponent(query)}&page=${page - 1}&sort=${sort}`}>← {copy.listing.previous}</a>}
        <a href={`?q=${encodeURIComponent(query)}&page=${page + 1}&sort=${sort}`}>{copy.listing.next} →</a>
      </nav>}
    </div>
  </section>
</BaseLayout>
