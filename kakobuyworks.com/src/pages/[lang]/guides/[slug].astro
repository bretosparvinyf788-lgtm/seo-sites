---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideCard from '../../../components/GuideCard.astro';
import { getLocalizedGuide, getLocalizedGuides, getGuideUi } from '../../../lib/guides';
import { isLang } from '../../../lib/i18n';

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/en/guides/', 302);
const lang = langParam;
const slug = Astro.params.slug || '';
const guide = getLocalizedGuide(slug, lang);
if (!guide) Astro.response.status = 404;
const ui = getGuideUi(lang);
const related = guide ? getLocalizedGuides(lang).filter((entry) => entry.slug !== guide.slug).slice(0, 2) : [];
const structuredData = guide ? [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    image: `https://kakobuyworks.com${guide.cover}`,
    datePublished: guide.date,
    dateModified: guide.date,
    inLanguage: lang,
    author: { '@type': 'Organization', name: 'Kakobuy Works' },
    publisher: { '@type': 'Organization', name: 'Kakobuy Works' },
    mainEntityOfPage: `https://kakobuyworks.com/${lang}/guides/${guide.slug}/`,
    keywords: [guide.primaryKeyword, ...guide.secondaryKeywords].join(', ')
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: `https://kakobuyworks.com/${lang}/` },
      { '@type': 'ListItem', position: 2, name: ui.nav, item: `https://kakobuyworks.com/${lang}/guides/` },
      { '@type': 'ListItem', position: 3, name: guide.title, item: `https://kakobuyworks.com/${lang}/guides/${guide.slug}/` }
    ]
  }
] : undefined;
---
{guide ? (
  <BaseLayout lang={lang} title={`${guide.title} | Kakobuy Works`} description={guide.description} canonicalPath={`/${lang}/guides/${guide.slug}/`} structuredData={structuredData}>
    <article class="guide-article" lang={lang}>
      <header class="guide-article-header">
        <div class="shell guide-article-heading">
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={`/${lang}/`}>{ui.home}</a><span>›</span><a href={`/${lang}/guides/`}>{ui.nav}</a><span>›</span><strong>{guide.primaryKeyword}</strong></nav>
          <span class="section-kicker">{ui.kicker}</span>
          <h1>{guide.title}</h1>
          <p>{guide.description}</p>
          <div class="guide-article-meta"><time datetime={guide.date}>{ui.updated}: {guide.date}</time><span>{guide.readingTime}</span></div>
        </div>
        <div class="shell guide-article-cover"><img src={guide.cover} alt={guide.coverAlt} /></div>
      </header>
      <div class="shell guide-article-layout">
        <aside class="guide-keywords"><strong>{ui.keywords}</strong><span>{guide.primaryKeyword}</span>{guide.secondaryKeywords.map((keyword) => <span>{keyword}</span>)}</aside>
        <div class="guide-prose" set:html={guide.articleHtml} />
      </div>
      <section class="section section-soft"><div class="shell"><div class="section-head"><div><span class="section-kicker">{ui.kicker}</span><h2>{ui.continueReading}</h2></div><a class="text-link" href={`/${lang}/guides/`}>{ui.back} →</a></div><div class="guide-grid guide-grid-related">{related.map((entry) => <GuideCard guide={entry} lang={lang} readLabel={ui.read} />)}</div></div></section>
    </article>
  </BaseLayout>
) : (
  <BaseLayout lang={lang} title={`${ui.notFoundTitle} | Kakobuy Works`} description={ui.notFoundBody} canonicalPath={`/${lang}/guides/${slug}/`}><section class="section"><div class="shell empty-state"><span>404</span><p>{ui.notFoundBody}</p><a class="button" href={`/${lang}/guides/`}>{ui.back}</a></div></section></BaseLayout>
)}
