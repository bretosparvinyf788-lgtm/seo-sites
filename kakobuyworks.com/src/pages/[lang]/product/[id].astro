---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProduct } from '../../../lib/source';
import { getCopy, getQcCopy, isLang } from '../../../lib/i18n';

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/en/', 302);
const lang = langParam;
const copy = getCopy(lang);
const qc = getQcCopy(lang);
const id = Astro.params.id || '';
let product = null;
try { product = await getProduct(id); } catch {}
if (!product) return new Response(copy.product.unavailable, { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
const title = `${product.title} | Kakobuy Spreadsheet`;
const description = `${product.title}, ${product.priceLabel}. Review source photos and open the matching marketplace item in Kakobuy.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  image: product.gallery,
  category: product.category,
  offers: product.price ? { '@type': 'Offer', priceCurrency: 'USD', price: product.price, availability: 'https://schema.org/InStock', url: product.kakobuyUrl } : undefined
};
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={`/${lang}/product/${product.id}/`} structuredData={structuredData}>
  <section class="section">
    <div class="shell"><a class="detail-back" href={`/${lang}/spreadsheet/`}>← {copy.nav.spreadsheet}</a></div>
    <div class="shell product-detail-grid">
      <div>
        <div class="gallery-main"><img id="main-product-image" src={product.gallery[0]} alt={product.title} referrerpolicy="no-referrer" /></div>
        {product.gallery.length > 1 && <div class="gallery-thumbs" aria-label={copy.product.gallery}>
          {product.gallery.map((image, index) => <button class:list={{ active: index === 0 }} type="button" data-image={image} aria-label={`${copy.product.gallery} ${index + 1}`}><img src={image} alt="" loading="lazy" referrerpolicy="no-referrer" /></button>)}
        </div>}
      </div>
      <div class="product-details">
        <span class="section-kicker">{qc.listing}</span>
        <h1>{product.title}</h1>
        <div class="product-price">{product.priceLabel}</div>
        <div class="product-facts"><span>{product.category}</span>{product.marketplaceId && <span>Weidian · {product.marketplaceId}</span>}</div>
        <p class="notice">{copy.product.currentNotice}</p>
        <div class="detail-actions">
          {product.kakobuyUrl && <a class="button" href={product.kakobuyUrl} target="_blank" rel="nofollow sponsored">{copy.product.openKakobuy} →</a>}
        </div>
        <p class="detail-source">Source record ID: {product.id}{product.marketplaceId ? ` · Marketplace item: ${product.marketplaceId}` : ''}</p>
      </div>
    </div>
    <section class="shell qc-reference">
      <div class="qc-reference-head">
        <div><span class="section-kicker">QC PHOTO REFERENCE</span><h2>{qc.title}</h2><p>{qc.body}</p></div>
        <strong>{product.gallery.length} {qc.photos}</strong>
      </div>
      <div class="qc-photo-grid">
        {product.gallery.map((image, index) => <img src={image} alt={`${product.title} — QC reference ${index + 1}`} loading="lazy" referrerpolicy="no-referrer" />)}
      </div>
    </section>
  </section>
  <script>
    const mainImage = document.querySelector('#main-product-image');
    document.querySelectorAll('[data-image]').forEach((button) => {
      button.addEventListener('click', () => {
        const image = button.getAttribute('data-image');
        if (mainImage instanceof HTMLImageElement && image) mainImage.src = image;
        document.querySelectorAll('[data-image]').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
      });
    });
  </script>
</BaseLayout>
