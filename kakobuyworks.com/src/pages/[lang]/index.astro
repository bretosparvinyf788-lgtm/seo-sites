---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCategories, getProducts } from '../../lib/source';
import { getLocalizedGuides, getGuideUi } from '../../lib/guides';
import { getCopy, isLang } from '../../lib/i18n';

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/en/', 302);
const lang = langParam;
const copy = getCopy(lang);
const guideCopy = getGuideUi(lang);
const guides = getLocalizedGuides(lang);

let categories = [];
let products = [];
let sourceUnavailable = false;
try {
  [categories, products] = await Promise.all([getCategories(), getProducts({ categoryId: '1', page: 2 })]);
  products = products.slice(0, 12);
} catch (error) {
  console.error('SOURCE_HOME_ERROR', error);
  sourceUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('retry-after', '300');
}

const title = `${copy.hero.title} | ${copy.sections.recent}`;
const description = copy.hero.body;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Kakobuy Works',
    url: `https://kakobuyworks.com/${lang}/`,
    potentialAction: {
      '@type': 'SearchAction',
      target: `https://kakobuyworks.com/${lang}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer }
    }))
  }
];
---
<BaseLayout lang={lang} title={title} description={description} canonicalPath={`/${lang}/`} robots={sourceUnavailable ? 'noindex,follow' : undefined} structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero-inner">
      <span class="eyebrow">{copy.hero.eyebrow}</span>
      <h1>{copy.hero.title}</h1>
      <p>{copy.hero.body}</p>
      <div class="hero-actions"><a class="text-link" href={`/${lang}/spreadsheet/`}>{copy.hero.browse} →</a></div>
      <nav class="hero-category-links" aria-label={copy.sections.categories}>
        <span>{copy.sections.categories}</span>
        {categories.filter((category) => category.id !== '1').slice(0, 3).map((category) => (
          <a href={`/${lang}/category/${category.id}/`}>{category.name} <span aria-hidden="true">→</span></a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="categories">
    <div class="shell">
      <div class="section-head">
        <div><span class="section-kicker">{copy.sections.categories}</span><h2>{copy.sections.categories}</h2><p>{copy.sections.categoriesBody}</p></div>
        <a class="text-link" href={`/${lang}/categories/`}>{copy.sections.viewAll} →</a>
      </div>
      {categories.length ? (
        <div class="category-grid">
          {categories.filter((category) => category.id !== '1').slice(0, 10).map((category) => (
            <a class="category-card" href={`/${lang}/category/${category.id}/`}>
              <span>{String(Number(category.id)).padStart(2, '0')}</span>
              <strong>{category.name}</strong>
              <small>{copy.sections.details} →</small>
            </a>
          ))}
        </div>
      ) : <div class="empty-state"><p>{copy.listing.sourceError}</p></div>}
    </div>
  </section>

  <section class="section section-soft" id="products">
    <div class="shell">
      <div class="section-head">
        <div><span class="section-kicker">{copy.sections.sourceLive}</span><h2>{copy.sections.recent}</h2><p>{copy.sections.recentBody}</p></div>
        <a class="text-link" href={`/${lang}/spreadsheet/`}>{copy.sections.viewAll} →</a>
      </div>
      <ProductGrid products={products} lang={lang} detailsLabel={copy.sections.details} emptyText={sourceUnavailable ? copy.listing.sourceError : copy.listing.noResults} />
    </div>
  </section>

  <section class="section" id="guides">
    <div class="shell">
      <div class="section-head">
        <div><span class="section-kicker">{guideCopy.kicker}</span><h2>{guideCopy.title}</h2><p>{guideCopy.body}</p></div>
        <a class="text-link" href={`/${lang}/guides/`}>{guideCopy.all} →</a>
      </div>
      <div class="guide-grid">{guides.map((guide) => <GuideCard guide={guide} lang={lang} readLabel={guideCopy.read} />)}</div>
    </div>
  </section>

  <section class="section section-soft" id="about">
    <div class="shell feature-grid">
      <div class="feature-intro"><h2>{copy.seo.title}</h2><p>{copy.seo.body}</p></div>
      <article class="feature-card"><span>01</span><h3>{copy.seo.searchTitle}</h3><p>{copy.seo.searchBody}</p></article>
      <article class="feature-card"><span>02</span><h3>{copy.seo.photosTitle}</h3><p>{copy.seo.photosBody}</p></article>
      <article class="feature-card"><span>03</span><h3>{copy.seo.checkoutTitle}</h3><p>{copy.seo.checkoutBody}</p></article>
    </div>
  </section>

  <section class="section faq-section" id="faq">
    <div class="shell">
      <div class="faq-heading"><span class="section-kicker">FAQ</span><h2>{copy.faqTitle}</h2><p>{copy.faqIntro}</p></div>
      <div class="faq-list faq-reference-grid">
        {copy.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="browse-cta">
    <div class="shell">
      <span class="section-kicker">{copy.sections.sourceLive}</span>
      <h2>{copy.hero.browse}</h2>
      <a class="button" href={`/${lang}/spreadsheet/`}>{copy.sections.viewAll} →</a>
    </div>
  </section>
</BaseLayout>
