---
import Header from '../components/Header.astro';
import { getCopy, languages, type Lang } from '../lib/i18n';
import { getGuideUi } from '../lib/guides';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  lang,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/images/guides/kakobuy-spreadsheet-guide-v2.webp',
  robots = 'index,follow,max-image-preview:large',
  structuredData
} = Astro.props;
const copy = getCopy(lang);
const guideCopy = getGuideUi(lang);
const site = Astro.site || new URL('https://kakobuyworks.com');
const canonical = new URL(canonicalPath, site).href;
const socialImage = new URL(image, site).href;
const relativePath = Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '') || '/';
const gaCandidate = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
const gaId = /^G-[A-Z0-9]+$/.test(gaCandidate) ? gaCandidate : '';
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION || '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/kakobuy-favicon.svg" type="image/svg+xml" />
    {Object.keys(languages).map((code) => (
      <link rel="alternate" hreflang={code === 'zh' ? 'zh-CN' : code} href={new URL(`/${code}${relativePath}`, Astro.site || 'https://kakobuyworks.com').href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${relativePath}`, Astro.site || 'https://kakobuyworks.com').href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    </script>}
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <img class="footer-logo" src="/brand/kakobuy-logo.svg?v=20260928-1" alt="Kakobuy" width="158" height="40" loading="lazy" />
          <p>{copy.listing.body} {copy.product.currentNotice}</p>
        </div>
        <div class="footer-links">
          <a href={`/${lang}/spreadsheet/`}>{copy.nav.spreadsheet}</a>
          <a href={`/${lang}/categories/`}>{copy.nav.categories}</a>
          <a href={`/${lang}/guides/`}>{guideCopy.nav}</a>
          <a href={`/${lang}/#faq`}>{copy.nav.faq}</a>
          <a href="https://www.kakobuy.com/register/?affcode=9qtwd" rel="nofollow sponsored" target="_blank">{copy.product.openKakobuy}</a>
        </div>
      </div>
      <div class="shell footer-bottom">© {new Date().getUTCFullYear()} Kakobuy Works</div>
    </footer>
  </body>
</html>
