{
  "name": "kakobuysheetdesk-com",
  "main": "cloudflare-dist/_worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "worker-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "routes": [
    {
      "pattern": "kakobuysheetdesk.com/*",
      "zone_name": "kakobuysheetdesk.com"
    },
    {
      "pattern": "www.kakobuysheetdesk.com/*",
      "zone_name": "kakobuysheetdesk.com"
    }
  ]
}
