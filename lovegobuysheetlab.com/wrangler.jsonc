{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovegobuysheetlab-com",
  "main": "worker.mjs",
  "account_id": "957cff16ad6c8cfb15c078cded9ac3dc",
  "compatibility_date": "2026-11-05",
